    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "dotenv": "^16.6.1",
    "expo": "~55.0.20",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.12",
    "expo-dev-client": "~55.0.32",
    "expo-device": "~55.0.15",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.10",
    "expo-image": "~55.0.8",
    "expo-linear-gradient": "~55.0.13",
