{
  "expo": {
    "name": "M100stacks",
    "slug": "M100stacks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",

    "ios": {
      "bundleIdentifier": "lv.stars.m100stacks",
      "supportsTablet": false,
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized notifications.",
        "UIBackgroundModes": ["remote-notification"],
        "LSApplicationQueriesSchemes": ["comgooglemaps", "waze", "maps"]
      }
    },
    "android": {
      "package": "lv.stars.m100stacks"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/with-maplibre",
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#be0a0a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a5557f3-d1af-43a2-a43c-801b710f2397"
      }
    },
    "owner": "gato-m"
  }
}
