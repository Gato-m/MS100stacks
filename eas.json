{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.19.4",
      "env": {
        "LOCAL_NO_PUSH": "1"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "node": "20.19.4",
      "ios": {
        "image": "latest",
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
